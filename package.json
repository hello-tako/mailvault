{
  "name": "mailvault",
  "private": true,
  "version": "0.1.0",
  "description": "MailVault V1 — private persistent domain-mail inbox on Cloudflare",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @mailvault/web build && pnpm --filter @mailvault/worker build",
    "build:web": "pnpm --filter @mailvault/web build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @mailvault/worker test:unit",
    "test:integration": "pnpm --filter @mailvault/worker test:integration",
    "test:e2e": "pnpm --filter @mailvault/web test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:web && pnpm test:e2e",
    "dev": "pnpm --filter @mailvault/worker dev",
    "web:dev": "pnpm --filter @mailvault/web dev",
    "clean": "rm -rf apps/*/dist apps/*/.wrangler node_modules/.vite && pnpm -r exec rm -rf dist .turbo",
    "deploy": "pnpm build:web && pnpm --filter @mailvault/worker deploy",
    "db:migrations:generate": "pnpm --filter @mailvault/worker db:migrations:generate",
    "db:migrate:local": "pnpm --filter @mailvault/worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @mailvault/worker db:migrate:remote"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "globals": "^15.14.0"
  }
}

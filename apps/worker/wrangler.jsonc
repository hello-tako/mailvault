{
  "$schema": "https://developers.cloudflare.com/workers/configuration/wrangler-file/",
  "name": "mail-vault",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "logpush": false,
  "workers_dev": false,

  "routes": [
    { "pattern": "mail.tungjp.store", "custom_domain": true },
    { "pattern": "mail.omnipos.tech", "custom_domain": true }
    // The portal hostname `code.tungjp.store` is deliberately NOT listed: this login cannot see the
    // `tungjp.store` zone, so wrangler can neither create nor keep a route for it. It is attached
    // through the API — see DEPLOYMENT.md, "The customer code portal".
  ],

  "observability": {
    "enabled": true
  },

  // Drift check only. This cron reads Cloudflare and updates MailVault's own rows; it
  // never deletes mail, never mutates a zone, and never runs on deploy.
  "triggers": {
    "crons": ["7 * * * *"]
  },

  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCOUNT_ID": "ef250a88911fd24073cb73d1c07e0218",
    "MAIL_WORKER_NAME": "mail-vault",
    "APP_ORIGIN": "https://mail.tungjp.store",
    // The origin printed in a customer's code link: a hostname with no Access in front of it.
    // See DEPLOYMENT.md, "The customer code portal".
    "PORTAL_ORIGIN": "https://code.tungjp.store",
    "CF_ACCESS_TEAM_DOMAIN": "https://little-bar-8ffa.cloudflareaccess.com",
    "CF_ACCESS_AUD": "61f4423b34844e1a86c2b4680a77549acab6026bb3a0ed78af75d78ff00d10b4",
    "MAX_MESSAGE_BYTES": "20971520",
    "MAX_SENDS_PER_DAY": "50",
    "ALLOWED_EMAILS": "tungbipdz@gmail.com",
    "DOMAIN_DENYLIST": "tungjpstore.net,selinow.com,fball.vn,logivn.com",
    "DELIVERY_EVENTS_QUEUE": "mail-delivery-events",
    "DEV_AUTH_BYPASS": "false"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mail-vault-db",
      "database_id": "c65bab2c-6af1-46fc-a07a-5ed1f36e6c69",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "mail-vault-storage"
    }
  ],

  // Staged mail waits here for its D1 commit. A commit that keeps failing is retried
  // three times and then parked in the dead-letter queue — the job carries R2 keys and
  // addressing only, so a queue is never a second home for message content.
  //
  // `mail-delivery-events` has no producer in this file: Cloudflare's Email Sending event
  // subscription writes it, one record per (message, recipient). That subscription is an
  // account resource rather than part of a deploy, so it is created once with
  // `wrangler queues subscription create` — see DEPLOYMENT.md.
  "queues": {
    "producers": [
      { "binding": "MAIL_INGEST_QUEUE", "queue": "mail-ingest" }
    ],
    "consumers": [
      {
        "queue": "mail-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 5,
        "dead_letter_queue": "mail-ingest-dlq"
      },
      {
        "queue": "mail-delivery-events",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 3,
        // A persistent database failure must not end with delivery events silently
        // disappearing after their retry budget — they park here, recoverable, exactly
        // like ingest jobs do. Created 2026-10-24 alongside mail-ingest-dlq.
        "dead_letter_queue": "mail-delivery-events-dlq"
      }
    ]
  },

  // Per-owner websocket hub. `new_sqlite_classes` runs the one-time migration that
  // creates the namespace; it is never re-applied on later deploys.
  // NB: this wrangler takes the code-side binding name in `name` — adding a `binding`
  // field is rejected as unexpected and silently renames the binding, which local dev
  // forgives and production does not.
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX_HUB", "class_name": "MailboxHub" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MailboxHub"] }
  ],

  // Rates and percentiles over time — see src/lib/metrics.ts for the column schema.
  // Counts and durations only; no address, subject or message id is ever written here.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "mailvault-events" }
  ],

  // Opt-in semantic search. Nothing is embedded until the owner turns it on in Settings.
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "mailvault-messages" }
  ],

  // Email Sending. Receiving is Email Routing's `email()` handler above; this is the way
  // out. Composing is refused per-domain unless that domain shows ENABLED in its sending
  // status, which only an owner-confirmed onboarding can set.
  "send_email": [{ "name": "EMAIL" }],

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
